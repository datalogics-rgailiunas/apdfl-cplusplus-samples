#include "../utils/MacSDKConfigurations/Environment.xcconfig"

//Library search paths for all targets
FRAMEWORK_SEARCH_PATHS = $(FRAMEWORK_SEARCH_PATHS) ../../Libs

DL_FRAMEWORK_PREFIX = DL100
DL_PDFL_FRAMEWORKS = -framework $(DL_FRAMEWORK_PREFIX)ACE -framework $(DL_FRAMEWORK_PREFIX)AGM -framework $(DL_FRAMEWORK_PREFIX)ARE -framework $(DL_FRAMEWORK_PREFIX)AXE8SharedExpat -framework $(DL_FRAMEWORK_PREFIX)BIB -framework $(DL_FRAMEWORK_PREFIX)BIBUtils -framework $(DL_FRAMEWORK_PREFIX)CoolType -framework $(DL_FRAMEWORK_PREFIX)JP2KLib -framework $(DL_FRAMEWORK_PREFIX)AdobeXMP -framework $(DL_FRAMEWORK_PREFIX)PDFL

// Header Search Paths for all projects
HEADER_SEARCH_PATHS = $(HEADER_SEARCH_PATHS) ../utils ../../Include/Headers

// Build for standard 32/64 bit arches
ARCHS = $(ARCHS_STANDARD_32_64_BIT)

// Set deployment target to 10.5.
// This is the minimum required version for 64-bit support.
MACOSX_DEPLOYMENT_TARGET = 10.5;

//
// GENERAL - Build Locations
//

SDKROOT = macosx

// Put our PCH's in our Build folder
SHARED_PRECOMPS_DIR = $(PDFLSDK_SOURCE_TREE_ROOT)/Build/pch

//
// GENERAL - Linking
//
PREBINDING = NO

// Always dead code strip
DEAD_CODE_STRIPPING = YES

// Allow for multiple definitions
BASE_OTHER_LDFLAGS =
OTHER_LDFLAGS = $(OTHER_LDFLAGS) $(BASE_OTHER_LDFLAGS) $(DL_PDFL_FRAMEWORKS)

// Default the product name to the target name
// add configuration to the product name to distinguish between
// debug and release binaries.
// Use hyphen instead of underscore for product name. Underscores
// are considered invalid characters for bundle identifiers in Xcode 4.3+
PRODUCT_NAME = $(TARGET_NAME)-$(CONFIGURATION)

// Plug-ins have the .acroplugin extension
WRAPPER_EXTENSION = app

// Info.plist file always has the same name and is in the Samples/utils folder
INFOPLIST_FILE = ../utils/Info.plist


// this should not be the same as DSTROOT!  If it is, you will
// sometimes get weird self-referential symlinks that cause the build to fail.
// build the app bundles in the project dir, and do NOT use DSTROOT.
// this way the relative paths for resources work out correctly.
CONFIGURATION_BUILD_DIR = $(PROJECT_DIR)


// Don't strip at copy
COPY_PHASE_STRIP = NO

//
// GNU C/C++ - Language
//

//Prefix header is in utils
GCC_PREFIX_HEADER = ../utils/PDFLPrecompile.pch

// Precompile the prefix
GCC_PRECOMPILE_PREFIX_HEADER = YES

BASE_OTHER_CPLUSPLUSFLAGS =
OTHER_CPLUSPLUSFLAGS = $(OTHER_CFLAGS) $(BASE_OTHER_CPLUSPLUSFLAGS)

//
// GNU C/C++ -  Code Generation
//

// Only show debug symbols for items used
GCC_DEBUGGING_SYMBOLS = used

// Tune for G5
GCC_MODEL_TUNING = G5

// Enums are INT
GCC_SHORT_ENUMS = NO

//
// GNU C/C++ - Warnings
//

// So void* can be cast to short, etc. w/o errors
GCC_TREAT_NONCONFORMANT_CODE_ERRORS_AS_WARNINGS = YES

// Warn about mismatched return types
GCC_WARN_ABOUT_RETURN_TYPE = YES

  

