//
// GENERAL - Architecture
//

// Build for standard 32/64 bit arches
ARCHS = $(ARCHS_STANDARD_32_64_BIT)

// Set deployment target to 10.5.
// This is the minimum required version for 64-bit support.
MACOSX_DEPLOYMENT_TARGET = 10.5;

//
// GNU C/C++ - Code Generation
//

GCC_OPTIMIZATION_LEVEL = s

//
// GNU C/C++ - Preprocessing
//
BASE_GCC_PREPROCESSOR_DEFINITIONS = AS_DEBUG=0 DISABLECPLUSPLUSDURING=0 EXCEPTIONS_ALWAYS_CPLUSPLUS=1 NDEBUG
GCC_PREPROCESSOR_DEFINITIONS = $(GCC_PREPROCESSOR_DEFINITIONS) $(BASE_GCC_PREPROCESSOR_DEFINITIONS)

//
// Deployment
//

// Turn on this so we can use the later stripping options
DEPLOYMENT_POSTPROCESSING = YES

// Strip us
STRIP_INSTALLED_PRODUCT = YES

// Use the strip tool instead of the linker
SEPARATE_STRIP = YES

// These two are equivement, but set them both just to make sure
STRIP_STYLE = debugging
STRIPFLAGS = -S

// Make sure we can still write over things for scripting
INSTALL_MODE_FLAG = a+rwX
